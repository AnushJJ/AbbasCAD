CREATE TYPE "Role" AS ENUM ('CUSTOMER','ADMIN');
CREATE TYPE "TripSeatStatus" AS ENUM ('AVAILABLE','HELD','BOOKED','BLOCKED');
CREATE TYPE "BookingStatus" AS ENUM ('CONFIRMED','CANCELLED','COMPLETED');
CREATE TYPE "HoldStatus" AS ENUM ('ACTIVE','CONSUMED','EXPIRED','RELEASED');
CREATE TYPE "PaymentStatus" AS ENUM ('PENDING','SUCCEEDED','FAILED','REFUNDED');
CREATE TABLE "User"("id" TEXT PRIMARY KEY,"username" TEXT NOT NULL UNIQUE,"email" TEXT NOT NULL UNIQUE,"passwordHash" TEXT NOT NULL,"name" TEXT NOT NULL,"phone" TEXT,"role" "Role" NOT NULL DEFAULT 'CUSTOMER',"createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE "City"("id" TEXT PRIMARY KEY,"name" TEXT NOT NULL UNIQUE,"code" TEXT NOT NULL UNIQUE);
CREATE TABLE "Route"("id" TEXT PRIMARY KEY,"originId" TEXT NOT NULL REFERENCES "City"("id"),"destinationId" TEXT NOT NULL REFERENCES "City"("id"),"distanceKm" INTEGER NOT NULL CHECK("distanceKm">0),"baseFarePaise" INTEGER NOT NULL CHECK("baseFarePaise">=0),UNIQUE("originId","destinationId"));
CREATE TABLE "Bus"("id" TEXT PRIMARY KEY,"name" TEXT NOT NULL,"operator" TEXT NOT NULL,"type" TEXT NOT NULL);
CREATE TABLE "BusSeat"("id" TEXT PRIMARY KEY,"busId" TEXT NOT NULL REFERENCES "Bus"("id") ON DELETE CASCADE,"number" TEXT NOT NULL,"category" TEXT NOT NULL,"premium" BOOLEAN NOT NULL DEFAULT FALSE,UNIQUE("busId","number"));
CREATE TABLE "Trip"("id" TEXT PRIMARY KEY,"routeId" TEXT NOT NULL REFERENCES "Route"("id"),"busId" TEXT NOT NULL REFERENCES "Bus"("id"),"departureAt" TIMESTAMP(3) NOT NULL,"arrivalAt" TIMESTAMP(3) NOT NULL,"fareMultiplier" INTEGER NOT NULL DEFAULT 100 CHECK("fareMultiplier">0));
CREATE INDEX "Trip_route_departure_idx" ON "Trip"("routeId","departureAt");
CREATE TABLE "SeatHold"("id" TEXT PRIMARY KEY,"userId" TEXT NOT NULL REFERENCES "User"("id"),"tripId" TEXT NOT NULL REFERENCES "Trip"("id") ON DELETE CASCADE,"status" "HoldStatus" NOT NULL DEFAULT 'ACTIVE',"expiresAt" TIMESTAMP(3) NOT NULL,"idempotencyKey" TEXT UNIQUE,"createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE INDEX "SeatHold_trip_status_expiry_idx" ON "SeatHold"("tripId","status","expiresAt");
CREATE TABLE "HeldSeat"("id" TEXT PRIMARY KEY,"holdId" TEXT NOT NULL REFERENCES "SeatHold"("id") ON DELETE CASCADE,"seatId" TEXT NOT NULL,"farePaise" INTEGER NOT NULL CHECK("farePaise">=0),UNIQUE("holdId","seatId"));
CREATE TABLE "Booking"("id" TEXT PRIMARY KEY,"userId" TEXT NOT NULL REFERENCES "User"("id"),"tripId" TEXT NOT NULL REFERENCES "Trip"("id"),"status" "BookingStatus" NOT NULL DEFAULT 'CONFIRMED',"distanceKm" INTEGER NOT NULL CHECK("distanceKm">0),"totalPaise" INTEGER NOT NULL CHECK("totalPaise">=0),"idempotencyKey" TEXT UNIQUE,"createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE INDEX "Booking_user_created_idx" ON "Booking"("userId","createdAt");
CREATE TABLE "BookingSeat"("id" TEXT PRIMARY KEY,"bookingId" TEXT NOT NULL REFERENCES "Booking"("id") ON DELETE CASCADE,"seatId" TEXT NOT NULL,"farePaise" INTEGER NOT NULL CHECK("farePaise">=0),UNIQUE("bookingId","seatId"));
CREATE TABLE "TripSeatInventory"("id" TEXT PRIMARY KEY,"tripId" TEXT NOT NULL REFERENCES "Trip"("id") ON DELETE CASCADE,"seatId" TEXT NOT NULL REFERENCES "BusSeat"("id"),"status" "TripSeatStatus" NOT NULL DEFAULT 'AVAILABLE',"holdId" TEXT REFERENCES "SeatHold"("id"),"bookingSeatId" TEXT UNIQUE REFERENCES "BookingSeat"("id"),UNIQUE("tripId","seatId"));
CREATE INDEX "TripSeatInventory_trip_status_idx" ON "TripSeatInventory"("tripId","status");
CREATE TABLE "PaymentAttempt"("id" TEXT PRIMARY KEY,"bookingId" TEXT NOT NULL UNIQUE REFERENCES "Booking"("id"),"amountPaise" INTEGER NOT NULL,"status" "PaymentStatus" NOT NULL DEFAULT 'PENDING',"providerReference" TEXT,"createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE "PricingRule"("id" TEXT PRIMARY KEY,"tripId" TEXT,"seatCategory" TEXT,"date" TIMESTAMP(3),"multiplier" INTEGER NOT NULL DEFAULT 100,"version" INTEGER NOT NULL DEFAULT 1,"active" BOOLEAN NOT NULL DEFAULT TRUE);
CREATE TABLE "LoyaltyAccount"("id" TEXT PRIMARY KEY,"userId" TEXT NOT NULL UNIQUE REFERENCES "User"("id"),"travelledKm" INTEGER NOT NULL DEFAULT 0,"rewardRedeemedAt" TIMESTAMP(3));
CREATE TABLE "CompletedJourneyRecord"("id" TEXT PRIMARY KEY,"bookingId" TEXT NOT NULL UNIQUE,"userId" TEXT NOT NULL,"distanceKm" INTEGER NOT NULL,"completedAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE INDEX "CompletedJourneyRecord_user_idx" ON "CompletedJourneyRecord"("userId");
CREATE TABLE "RewardRedemption"("id" TEXT PRIMARY KEY,"userId" TEXT NOT NULL,"rewardCode" TEXT NOT NULL,"redeemedAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,UNIQUE("userId","rewardCode"));
CREATE TABLE "IdempotencyRecord"("id" TEXT PRIMARY KEY,"key" TEXT NOT NULL UNIQUE,"userId" TEXT NOT NULL,"operation" TEXT NOT NULL,"response" JSONB,"createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE "AuditEvent"("id" TEXT PRIMARY KEY,"actorId" TEXT,"action" TEXT NOT NULL,"entityType" TEXT NOT NULL,"entityId" TEXT,"details" JSONB,"createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE INDEX "AuditEvent_created_idx" ON "AuditEvent"("createdAt");
CREATE TABLE "Cancellation"("id" TEXT PRIMARY KEY,"bookingId" TEXT NOT NULL UNIQUE,"refundPaise" INTEGER NOT NULL DEFAULT 0,"reason" TEXT,"createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP);
