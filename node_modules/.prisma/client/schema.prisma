generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum TripSeatStatus {
  AVAILABLE
  HELD
  BOOKED
  BLOCKED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum HoldStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  RELEASED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id           String          @id @default(cuid())
  username     String          @unique
  email        String          @unique
  passwordHash String
  name         String
  phone        String?
  role         Role            @default(CUSTOMER)
  createdAt    DateTime        @default(now())
  holds        SeatHold[]
  bookings     Booking[]
  loyalty      LoyaltyAccount?
}

model City {
  id         String  @id @default(cuid())
  name       String  @unique
  code       String  @unique
  routesFrom Route[] @relation("RouteOrigin")
  routesTo   Route[] @relation("RouteDestination")
}

model Route {
  id            String @id @default(cuid())
  originId      String
  destinationId String
  distanceKm    Int
  baseFarePaise Int
  origin        City   @relation("RouteOrigin", fields: [originId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination   City   @relation("RouteDestination", fields: [destinationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trips         Trip[]

  @@unique([originId, destinationId])
}

model Bus {
  id       String    @id @default(cuid())
  name     String
  operator String
  type     String
  seats    BusSeat[]
  trips    Trip[]
}

model BusSeat {
  id        String              @id @default(cuid())
  busId     String
  number    String
  category  String
  premium   Boolean             @default(false)
  bus       Bus                 @relation(fields: [busId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventory TripSeatInventory[]

  @@unique([busId, number])
}

model Trip {
  id             String              @id @default(cuid())
  routeId        String
  busId          String
  departureAt    DateTime
  arrivalAt      DateTime
  fareMultiplier Int                 @default(100)
  route          Route               @relation(fields: [routeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bus            Bus                 @relation(fields: [busId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventory      TripSeatInventory[]
  holds          SeatHold[]
  bookings       Booking[]

  @@index([routeId, departureAt], map: "Trip_route_departure_idx")
}

model TripSeatInventory {
  id            String         @id @default(cuid())
  tripId        String
  seatId        String
  status        TripSeatStatus @default(AVAILABLE)
  holdId        String?
  bookingSeatId String?        @unique
  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  seat          BusSeat        @relation(fields: [seatId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hold          SeatHold?      @relation(fields: [holdId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookingSeat   BookingSeat?   @relation(fields: [bookingSeatId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tripId, seatId])
  @@index([tripId, status], map: "TripSeatInventory_trip_status_idx")
}

model SeatHold {
  id             String              @id @default(cuid())
  userId         String
  tripId         String
  status         HoldStatus          @default(ACTIVE)
  expiresAt      DateTime
  idempotencyKey String?             @unique
  createdAt      DateTime            @default(now())
  user           User                @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trip           Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  seats          HeldSeat[]
  inventory      TripSeatInventory[]

  @@index([tripId, status, expiresAt], map: "SeatHold_trip_status_expiry_idx")
}

model HeldSeat {
  id        String   @id @default(cuid())
  holdId    String
  seatId    String
  farePaise Int
  hold      SeatHold @relation(fields: [holdId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([holdId, seatId])
}

model Booking {
  id             String          @id @default(cuid())
  userId         String
  tripId         String
  status         BookingStatus   @default(CONFIRMED)
  distanceKm     Int
  totalPaise     Int
  idempotencyKey String?         @unique
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seats          BookingSeat[]
  payment        PaymentAttempt?

  @@index([userId, createdAt], map: "Booking_user_created_idx")
}

model BookingSeat {
  id        String             @id @default(cuid())
  bookingId String
  seatId    String
  farePaise Int
  booking   Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventory TripSeatInventory?

  @@unique([bookingId, seatId])
}

model PaymentAttempt {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  amountPaise       Int
  status            PaymentStatus @default(PENDING)
  providerReference String?
  createdAt         DateTime      @default(now())
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model PricingRule {
  id           String    @id @default(cuid())
  tripId       String?
  seatCategory String?
  date         DateTime?
  multiplier   Int       @default(100)
  version      Int       @default(1)
  active       Boolean   @default(true)
}

model LoyaltyAccount {
  id               String    @id @default(cuid())
  userId           String    @unique
  travelledKm      Int       @default(0)
  rewardRedeemedAt DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model CompletedJourneyRecord {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  userId      String
  distanceKm  Int
  completedAt DateTime @default(now())

  @@index([userId], map: "CompletedJourneyRecord_user_idx")
}

model RewardRedemption {
  id         String   @id @default(cuid())
  userId     String
  rewardCode String
  redeemedAt DateTime @default(now())

  @@unique([userId, rewardCode])
}

model IdempotencyRecord {
  id        String   @id @default(cuid())
  key       String   @unique
  userId    String
  operation String
  response  Json?
  createdAt DateTime @default(now())
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt], map: "AuditEvent_created_idx")
}

model Cancellation {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  refundPaise Int      @default(0)
  reason      String?
  createdAt   DateTime @default(now())
}
